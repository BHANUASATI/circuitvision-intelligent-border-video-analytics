# ============================================================
# IBVAP — Intelligent Border Video Analytics Platform
# Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=change-me-to-a-long-random-secret
APP_DEBUG=false
APP_VERSION=1.0.0

# ── Database (PostgreSQL) ─────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ibvap
POSTGRES_USER=ibvap_user
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=postgresql+asyncpg://ibvap_user:change-me-strong-db-password@postgres:5432/ibvap

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# ── JWT Auth ──────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Service ────────────────────────────────────────────────
AI_SERVICE_HOST=ai_service
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://ai_service:8001

# YOLO model weights path (inside container)
YOLO_MODEL_PATH=/models/yolo/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_NMS_THRESHOLD=0.45

# Face recognition
FACE_MODEL_PATH=/models/face/buffalo_l
FACE_RECOGNITION_THRESHOLD=0.5
FACE_DB_PATH=/data/face_db

# ANPR
ANPR_MODEL_PATH=/models/anpr/anpr_yolo.pt
ANPR_OCR_LANG=en
PLATE_DB_PATH=/data/plate_db

# ── Camera / Stream ───────────────────────────────────────────
RTSP_DEFAULT_PORT=554
ONVIF_DEFAULT_PORT=80
STREAM_RECONNECT_DELAY=5          # seconds
STREAM_FRAME_SKIP=2               # process every Nth frame
MAX_CONCURRENT_STREAMS=16

# ── Evidence Storage ──────────────────────────────────────────
EVIDENCE_STORAGE_PATH=/data/evidence
EVIDENCE_RETENTION_DAYS=90
ENABLE_EVIDENCE_HASHING=true      # SHA-256 tamper-evident hashing

# ── Alerting ──────────────────────────────────────────────────
ALERT_COOLDOWN_SECONDS=30
ALERT_WEBSOCKET_PING_INTERVAL=25

# ── Security ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:80
RATE_LIMIT_PER_MINUTE=120
ENABLE_AUDIT_LOG=true

# ── Monitoring ────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
